{
  "compilerOptions": {
    "checkJs": false,
    "module": "es2020",
    "moduleResolution": "node",
    "target": "es2020",
    "lib": ["ES2020", "DOM"]
  },
  "exclude": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.tools/**",
    "**/mariadb/**",
    "**/local-mariadb/**",
    "**/deploy-bundle*/**",
    "**/releases/**",
    "**/backups/**",
    "**/logs/**",
    "**/coverage/**",
    "**/dist/**"
  ]
}
